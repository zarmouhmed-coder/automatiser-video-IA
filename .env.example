# MULTIVERSE STUDIO — secrets locaux (copiez en .env ; .env n'est JAMAIS versionné).
# Les clés peuvent aussi être saisies dans la page Paramètres (elles sont écrites ici).

# API Claude (console Anthropic, facturation à l'usage — distincte d'un abonnement claude.ai)
ANTHROPIC_API_KEY=

# Voix ElevenLabs (facultatif, payant)
ELEVENLABS_API_KEY=

# Optionnel : autre dossier de données / autre port
# MVS_DATA_DIR=D:\MultiverseStudio\data
# MVS_PORT=8765
